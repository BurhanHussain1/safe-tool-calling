# Copy this file to `.env` and fill in what you need.
#   PowerShell:  Copy-Item .env.example .env
# `.env` is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Leave the key unset to run fully offline: the planner falls back to recorded
# cassettes (tests) and a deterministic rule-based planner (manual poking).
ANTHROPIC_API_KEY=

# Which model plans the API calls.
#   claude-haiku-4-5  — fast and cheap; supports structured outputs. Good default.
#   claude-sonnet-5   — noticeably better on multi-step chains.
#   claude-opus-5     — best plans; use when you are demoing.
NL2API_MODEL=claude-haiku-4-5

# "anthropic" | "cassette" | "rules"
NL2API_LLM_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
NL2API_MOCK_API_URL=http://127.0.0.1:8000
NL2API_ASSISTANT_URL=http://127.0.0.1:8001
NL2API_REQUEST_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite by default. Swap for Postgres by changing this URL only, e.g.
#   postgresql+psycopg://nl2api:nl2api@localhost:5432/nl2api
NL2API_DATABASE_URL=sqlite:///./nl2api.db

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------
# The role the assistant acts as. viewer | support_agent | billing_admin
NL2API_DEFAULT_ROLE=support_agent

# Hard ceiling on refunds the assistant may propose, in cents. 50000 = $500.00
# This is a refusal, not an approval prompt: every refund is already gated on
# human approval by its risk level, so "require approval above X" would be a
# rule that never fires. Above this amount, a human uses the admin console.
NL2API_REFUND_MAX_CENTS=50000

# A plan touching more than this many write endpoints is rejected outright.
NL2API_MAX_WRITE_STEPS=3

# How many candidate endpoints to shortlist for the planner.
NL2API_RETRIEVER_TOP_K=6

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
NL2API_LOG_LEVEL=INFO
