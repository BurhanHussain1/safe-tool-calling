# Normalise line endings so the repo is identical on Windows, macOS and Linux
# (and so CI on ubuntu-latest sees the same bytes you committed).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch binaries
*.png  binary
*.jpg  binary
*.gif  binary
*.db   binary
*.pdf  binary
